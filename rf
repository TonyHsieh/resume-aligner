#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$SCRIPT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"

if [ -x "$SCRIPT_DIR/.devenv/state/venv/bin/python" ]; then
    exec "$SCRIPT_DIR/.devenv/state/venv/bin/python" -m resume_factory.cli "$@"
elif command -v devenv >/dev/null 2>&1; then
    exec devenv shell -- rf "$@"
else
    exec python3 -m resume_factory.cli "$@"
fi
